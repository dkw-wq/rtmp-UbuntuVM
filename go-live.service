[Unit]
Description=Go Live Streaming Management Server
Documentation=https://github.com/example/rtmp-UbuntuVM
After=network.target postgresql.service srs.service
Wants=postgresql.service srs.service

[Service]
Type=simple
ExecStart=/opt/rtmp-UbuntuVM/go-live-server/server
WorkingDirectory=/opt/rtmp-UbuntuVM/go-live-server
Restart=always
RestartSec=5
User=root
Group=root
Environment=GIN_MODE=release

[Install]
WantedBy=multi-user.target
